// Faculty Attendance and Time Log System — Prisma schema
// See docs/Faculty_Attendance_System_Full_Spec.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users, roles, permissions
// ---------------------------------------------------------------------------

model User {
  id                 Int          @id @default(autoincrement())
  name               String
  username           String       @unique
  passwordHash       String       @map("password_hash")
  active             Boolean      @default(true)
  mustChangePassword Boolean      @default(true) @map("must_change_password")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  userRoles          UserRole[]
  encodedAttendances Attendance[] @relation("EncodedBy")
  savedSessions      AttendanceSession[] @relation("SavedBy")
  auditLogs          AuditLog[]
  importBatches      ImportBatch[] @relation("ImportedBy")
  repairSources      RepairSource[] @relation("RepairBy")
  repairDecisions    RepairFinding[] @relation("RepairDecidedBy")
  attendanceDrafts   AttendanceDraft[]
  reportSignatures   ReportSignature[] @relation("SignatureUpdatedBy")

  @@map("users")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  canDelete       Boolean          @default(true) @map("can_delete")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Master lists
// ---------------------------------------------------------------------------

model Faculty {
  id           Int            @id @default(autoincrement())
  fullName     String         @map("full_name")
  surname      String
  // The faculty member's official department. This is independent of the
  // programs they teach; a CET instructor may teach a BSIT minor subject
  // without becoming a BSIT faculty member. NULL means "not yet reviewed".
  departmentId Int?           @map("department_id")
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  department   College?       @relation("FacultyDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  slots        ScheduleSlot[]

  @@index([active])
  @@index([departmentId])
  @@map("faculty")
}

// A college/department. Programs (Course) point at one college; a program with
// no college is "unassigned" and waits for an administrator decision.
model College {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  courses   Course[]
  faculty   Faculty[] @relation("FacultyDepartment")

  @@map("colleges")
}

model Course {
  id         Int            @id @default(autoincrement())
  code       String         @unique
  name       String?
  collegeId  Int?           @map("college_id")
  // The value as written in the source workbook, kept even when the normalized
  // program code differs.
  sourceCode String?        @map("source_code")
  // False for programs that are not in the school's official program list.
  official   Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  college    College?       @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  slots      ScheduleSlot[]
  sessions   AttendanceSession[]

  @@index([collegeId])
  @@map("courses")
}

model Room {
  id        Int            @id @default(autoincrement())
  code      String         @unique
  type      RoomType
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  slots     ScheduleSlot[]

  @@map("rooms")
}

enum RoomType {
  PHYSICAL @map("physical")
  ONLINE   @map("online")
  TBA      @map("tba")

  @@map("room_type")
}

enum Mode {
  FACE_TO_FACE @map("face-to-face")
  ONLINE       @map("online")
  LAB          @map("lab")

  @@map("mode")
}

// ---------------------------------------------------------------------------
// Schedule
// ---------------------------------------------------------------------------

model ScheduleSlot {
  id          Int          @id @default(autoincrement())
  cn          String       @map("class_number")
  subject     String
  description String?
  units       Int          @default(0)
  section     String?
  yearLevel   String?      @map("year_level")
  courseId    Int          @map("course_id")
  facultyId   Int?         @map("faculty_id")
  weekday     Int // 0=Sunday .. 6=Saturday
  startTime   String       @map("start_time") // HH:mm
  endTime     String       @map("end_time")   // HH:mm
  roomId      Int          @map("room_id")
  mode        Mode         @default(FACE_TO_FACE)
  termType    String?      @map("term_type")
  schoolYear  String?      @map("school_year") // e.g. "2026-2027"
  semester    String?      // e.g. "1st Semester"
  slotsInfo   String?      @map("slots") // enrollment "47/45" (informational)
  importBatchId Int?       @map("import_batch_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  course      Course       @relation(fields: [courseId], references: [id])
  faculty     Faculty?     @relation(fields: [facultyId], references: [id])
  room        Room         @relation(fields: [roomId], references: [id])
  attendance  Attendance[]
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([facultyId])
  @@index([courseId])
  @@index([weekday, startTime, endTime])
  @@index([schoolYear, semester])
  @@index([importBatchId])
  @@map("schedule_slots")
}

// One row per import commit, so an inaccurate upload can be identified and
// cleared separately from manual or later imports.
model ImportBatch {
  id           Int            @id @default(autoincrement())
  filename     String
  schoolYear   String         @map("school_year")
  semester     String
  slotCount    Int            @default(0) @map("slot_count")
  // SHA-256 of the uploaded workbook. Lets the importer recognise the exact
  // same file being committed twice into the same academic period.
  checksum     String?
  importedById Int?           @map("imported_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  importedBy   User?          @relation("ImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  slots        ScheduleSlot[]

  @@index([schoolYear, semester])
  @@index([schoolYear, semester, checksum])
  @@index([createdAt])
  @@map("import_batches")
}

// ---------------------------------------------------------------------------
// Academic periods
// ---------------------------------------------------------------------------

enum AcademicPeriodStatus {
  ACTIVE   @map("active")
  UPCOMING @map("upcoming")
  ARCHIVED @map("archived")

  @@map("academic_period_status")
}

// One configured school year + semester. Periods are created explicitly by an
// administrator (or when an import supplies semester dates) so attendance can
// never be generated against an invented academic period. Dates are nullable
// for legacy term pairs that predate this table; NULL means "not reviewed".
model AcademicPeriod {
  id         Int                   @id @default(autoincrement())
  schoolYear String                @map("school_year")
  semester   String
  startDate  DateTime?             @map("start_date") @db.Date
  endDate    DateTime?             @map("end_date") @db.Date
  status     AcademicPeriodStatus?
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  @@unique([schoolYear, semester])
  @@index([schoolYear, semester])
  @@map("academic_periods")
}

// ---------------------------------------------------------------------------
// Schedule repair
// ---------------------------------------------------------------------------

// One immutable snapshot of a repair analysis over an uploaded workbook. The
// checksum makes the same file idempotent: re-uploading an identical workbook
// reuses the source and its findings instead of creating duplicates.
model RepairSource {
  id          Int             @id @default(autoincrement())
  filename    String
  checksum    String          @unique
  schoolYear  String?         @map("school_year")
  semester    String?
  rowCount    Int             @default(0) @map("row_count")
  summary     Json? // RepairSummary snapshot for fast rendering
  rows        Json? // raw worksheet rows, kept so apply/rollback is reproducible
  createdById Int?            @map("created_by_id")
  appliedBatchId Int?         @map("applied_batch_id")
  appliedAt   DateTime?       @map("applied_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  createdBy   User?           @relation("RepairBy", fields: [createdById], references: [id], onDelete: SetNull)
  findings    RepairFinding[]

  @@index([createdAt])
  @@map("repair_sources")
}

// A single structured issue on one worksheet row. Carries the original value,
// the deterministic proposal, who decided what and when, and the value that was
// actually written — so every correction is reversible and auditable.
model RepairFinding {
  id           Int          @id @default(autoincrement())
  sourceId     Int          @map("source_id")
  rowNumber    Int          @map("row_number")
  code         String
  severity     String
  certainty    String
  field        String
  cn           String?
  original     String?
  proposed     String?
  evidence     String?
  explanation  String
  status       String       @default("open") // open | accepted | rejected | unresolved | applied
  appliedValue String?      @map("applied_value")
  decidedById  Int?         @map("decided_by_id")
  decidedAt    DateTime?    @map("decided_at")
  appliedAt    DateTime?    @map("applied_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  source       RepairSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  decidedBy    User?        @relation("RepairDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([sourceId, status])
  @@index([sourceId, rowNumber])
  @@map("repair_findings")
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

enum DayStatus {
  DRAFT @map("draft")
  SAVED @map("saved")

  @@map("day_status")
}

// Scope completion: one row per (date, program). "Not encoded" = no row.
model AttendanceSession {
  id        Int          @id @default(autoincrement())
  date      DateTime     @db.Date
  courseId  Int          @map("course_id")
  status    DayStatus    @default(DRAFT)
  savedById Int?         @map("saved_by_id")
  savedAt   DateTime?    @map("saved_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  course    Course       @relation(fields: [courseId], references: [id])
  savedBy   User?        @relation("SavedBy", fields: [savedById], references: [id])
  records   Attendance[]

  @@unique([date, courseId])
  @@index([date])
  @@map("attendance_sessions")
}

model Attendance {
  id           Int          @id @default(autoincrement())
  slotId       Int          @map("slot_id")
  sessionId    Int?         @map("session_id")
  date         DateTime     @db.Date
  hourStart    String       @map("hour_start") // HH:mm — one row per scheduled hour
  // NULL = not yet encoded. true = present, false = absent. A missing row and a
  // NULL row are both "not encoded" and must never be counted as an absence.
  present      Boolean?     @map("present")
  reason       String?
  roomOverride String?      @map("room_override")
  encodedById  Int          @map("encoded_by")
  encodedAt    DateTime     @default(now()) @map("encoded_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  slot         ScheduleSlot @relation(fields: [slotId], references: [id])
  session      AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  encodedBy    User         @relation("EncodedBy", fields: [encodedById], references: [id])

  @@unique([slotId, date, hourStart])
  @@index([date])
  @@index([slotId, date])
  @@map("attendance")
}

// ---------------------------------------------------------------------------
// Calendar, settings, audit
// ---------------------------------------------------------------------------

model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  label     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([date])
  @@index([date])
  @@map("holidays")
}

model Settings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Drafts and print signatures
// ---------------------------------------------------------------------------

// Autosaved working state for an attendance encoding session. Drafts are
// private to the user who created them and never finalize attendance: only the
// explicit Save Attendance action writes official `attendance` rows.
model AttendanceDraft {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  // Stable scope such as `encode:CET:2026-10-27:2026-2027:1st Semester`.
  scopeKey  String   @map("scope_key")
  payload   Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeKey])
  @@index([updatedAt])
  @@map("attendance_drafts")
}

// Prepared-by / checked-by values for a printable attendance scope. Scoped by
// department (or program) and term so revisiting the same sheet restores the
// names without re-typing them, while a different department keeps its own.
model ReportSignature {
  id                  Int      @id @default(autoincrement())
  scopeKey            String   @unique @map("scope_key")
  preparedBy          String   @default("") @map("prepared_by")
  preparedDesignation String   @default("") @map("prepared_designation")
  checkedBy           String   @default("") @map("checked_by")
  checkedDesignation  String   @default("") @map("checked_designation")
  updatedById         Int?     @map("updated_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  updatedBy           User?    @relation("SignatureUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
  @@map("report_signatures")
}
