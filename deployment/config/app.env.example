# Faculty Attendance and Time Log System - Production Configuration Template
# This file is automatically generated by the installer into:
# C:\ProgramData\FacultyAttendance\app.env

# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/faculty_attendance_new?schema=public

# Application session cryptographic secret (auto-generated by installer)
SESSION_SECRET=GENERATE_RANDOM_32_BYTES_BASE64_SECRET

# Cookie security (set to false for HTTP on LAN; true if using HTTPS reverse proxy)
SESSION_COOKIE_SECURE=false

# Web server port (default: 3000)
PORT=3000

# Network interface to bind (0.0.0.0 for LAN access; 127.0.0.1 for local host only)
BIND_ADDRESS=0.0.0.0

# Directory where automated and manual database backups are saved
BACKUP_DIR=C:\ProgramData\FacultyAttendance\backups

# Paths to PostgreSQL tools (auto-detected by installer)
PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
PG_RESTORE_PATH=C:\Program Files\PostgreSQL\18\bin\pg_restore.exe
PG_BIN=C:\Program Files\PostgreSQL\18\bin

# Production environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
